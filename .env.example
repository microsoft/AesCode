# AesCode — environment template. Copy to `.env` and fill in.
# `.env` is gitignored; never commit real credentials.

# ── Hosted models ───────────────────────────────────────────────────────────
# One OpenAI-compatible endpoint, shared by every hosted call.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Vision model: builds rubrics, judges renderings, recovers generation prompts.
VLM_MODEL=gpt-5.5
# Image model: drafts a reference image from a one-line idea.
IMAGE_MODEL=gpt-image-2
# Optional: run the generation half on Claude instead of a local checkpoint.
ANTHROPIC_API_KEY=

# ── A served AesCode checkpoint ─────────────────────────────────────────────
# The vLLM server hosting a released checkpoint.
AESCODE_BASE_URL=http://127.0.0.1:8000/v1
AESCODE_API_KEY=EMPTY

# ── Paths ───────────────────────────────────────────────────────────────────
# Writable working root: checkpoints, caches, rendered artifacts, logs.
AESCODE_ROOT=/path/to/workdir
# This repository. Defaults to the repo root if unset.
AESCODE_HOME=/path/to/AesCode
# Python environment holding verl, vLLM and torch.
AESCODE_PY_ENV=/path/to/envs/verl
# Where evaluation outputs are published.
AESCODE_OUTPUT_ROOT=/path/to/outputs
