# =============================================================================
# DesignCoder — credentials & runtime config (EXAMPLE)
# Copy to `.env` in the repo root and fill in real values. `.env` is gitignored.
# All Python entry points and the training launchers auto-load this file.
# =============================================================================

# ── Azure OpenAI (used by spec/ and by the VLM design reward) ────────────────
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_ENDPOINT=https://<your-endpoint>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# ── VLM reward endpoint (DesignValidator / RubricDesignScorer) ───────────────
# The design dimension calls a VLM judge over an OpenAI-compatible endpoint.
VLM_REWARD_BASE_URL=https://<your-endpoint>.openai.azure.com/
VLM_REWARD_API_KEY=<your-key>
VLM_REWARD_MODEL=gpt-5.4
VLM_REWARD_CONCURRENCY=32
# Optional global rate limiting for shared endpoints:
# VLM_GLOBAL_RPM_LIMIT=
# VLM_RPM_HEADROOM_PCT=
# VLM_ACTIVE_ENDPOINTS=

# ── Image model for reference-image / placeholder generation (demo) ──────────
# Gemini (Nano Banana Pro) — default provider for eval/demo_generate.py
GOOGLE_NANO_BANANA=<your-google-ai-api-key>
# Optional: override the image model name (defaults: gemini→gemini-3-pro-image-preview,
# azure→gpt-image-2). Used by eval/demo_generate.py.
# IMAGE_MODEL=
# (Azure gpt-image provider reuses AZURE_OPENAI_* above.)

# ── Serve your own trained DesignCoder model (optional; demo stage 3) ─────────
# Used by `eval/demo_generate.py --provider vllm`. Point at any OpenAI-compatible
# server (e.g. `vllm serve <ckpt> --served-model-name designcoder`).
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=designcoder
# VLLM_API_KEY=EMPTY

# ── Weights & Biases (optional; launchers default to console/disabled) ───────
# WANDB_API_KEY=<your-key>
# WANDB_MODE=online
